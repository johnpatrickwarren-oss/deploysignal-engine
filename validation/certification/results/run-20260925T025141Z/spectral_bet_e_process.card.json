    "guarantee": {
      "sentence": "periodogram betting e-process: per disjoint 30-tick window, p_k = exp(-U_k) is exactly Uniform(0,1) for iid N(0,sigma^2) noise at Fourier bins k in {1,2,3} (k not in {0,15}), sigma known; e_k = kappa*p_k^(kappa-1) satisfies E[e_k|H0] <= 1; per window, bins combine by averaging e-values (never max); across disjoint windows, the per-window averages combine by product (independent increments), giving wealth = prod_w mean_k(e_k,w) -- product-over-windows of per-window bin-averages, the form this module implements, not the design page's average-of-per-bin-wealths (mean_k prod_w e_k,w); both are valid e-processes, but they are not the same statistic -- canonical-cell numeric divergence measured at 1.5pp (Task 6 review-time probe, filed for wiki write-back, PREREGISTRATION.md Amendment v2.K3 K3.4)",
      "quantifiers": [
        {
          "text": "per-window exact uniformity + product over disjoint windows + average-over-bins validity",
          "tag": "proof",
          "proof_artifact": "exactness identity (2U_k ~ chi^2_2 at k not in {0, W/2}), module docstring detectors/spectral-bet-e-process.ts:22-27; never-max mutation-killed fixture + NaN-hold/p-underflow degenerate-path fixtures, test/spectral-bet-e-process.test.ts"
        }
      ],
      "regime": {
        "phi_max": 0,
        "m_min": null,
        "baseline": "oracle",
        "nulls": "iid-gaussian",
        "sigma_known": true,
