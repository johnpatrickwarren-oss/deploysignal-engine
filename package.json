{
  "name": "@johnpatrickwarren-oss/deploysignal-engine",
  "version": "0.9.0-pre",
  "description": "Statistical detector library: detectors with their validity envelopes, e-value combination and e-BH/e-BY FDR, per-shard baseline maths, and the guarantee table that says what each detector guarantees and in which regime (ADR 0033).",
  "license": "Apache-2.0",
  "main": "./dist/types/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "!dist/test/**",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnpatrickwarren-oss/deploysignal-engine.git"
  },
  "bin": {
    "ds-engine-nab-validate": "./dist/tools/run-nab-validation.js",
    "ds-engine-nab-per-dataset": "./dist/tools/run-nab-per-dataset.js",
    "ds-engine-fit-substrate": "./dist/tools/fit-production-substrate.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "nab:validate": "node dist/tools/run-nab-validation.js",
    "nab:per-dataset": "node dist/tools/run-nab-per-dataset.js",
    "cert:verdict": "node validation/certification/verdict.mjs",
    "cert:validate-cards": "node validation/certification/tools/validate-cards.mjs",
    "cert:expiry": "node validation/certification/expiry-check.mjs",
    "test:cert": "node --test validation/certification/test/*.test.mjs",
    "test:coverage-battery": "node --test validation/coverage/test/*.test.mjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/*/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/agent": {
      "types": "./dist/types/agent.d.ts",
      "default": "./dist/types/agent.js"
    },
    "./types/audit": {
      "types": "./dist/types/audit.d.ts",
      "default": "./dist/types/audit.js"
    },
    "./types/config": {
      "types": "./dist/types/config.d.ts",
      "default": "./dist/types/config.js"
    },
    "./types/fleet": {
      "types": "./dist/types/fleet.d.ts",
      "default": "./dist/types/fleet.js"
    },
    "./types/metrics": {
      "types": "./dist/types/metrics.d.ts",
      "default": "./dist/types/metrics.js"
    },
    "./types/orchestration": {
      "types": "./dist/types/orchestration.d.ts",
      "default": "./dist/types/orchestration.js"
    },
    "./types/policy": {
      "types": "./dist/types/policy.d.ts",
      "default": "./dist/types/policy.js"
    },
    "./types/primitives": {
      "types": "./dist/types/primitives.d.ts",
      "default": "./dist/types/primitives.js"
    },
    "./types/self-normalized-fallback": {
      "types": "./dist/types/self-normalized-fallback.d.ts",
      "default": "./dist/types/self-normalized-fallback.js"
    },
    "./types/verdict": {
      "types": "./dist/types/verdict.d.ts",
      "default": "./dist/types/verdict.js"
    },
    "./types/verdict-extensions/cluster-topology": {
      "types": "./dist/types/verdict-extensions/cluster-topology.d.ts",
      "default": "./dist/types/verdict-extensions/cluster-topology.js"
    },
    "./types/verdict-extensions/evidence-surface": {
      "types": "./dist/types/verdict-extensions/evidence-surface.d.ts",
      "default": "./dist/types/verdict-extensions/evidence-surface.js"
    },
    "./types/families/a": {
      "types": "./dist/types/families/a.d.ts",
      "default": "./dist/types/families/a.js"
    },
    "./types/families/b": {
      "types": "./dist/types/families/b.d.ts",
      "default": "./dist/types/families/b.js"
    },
    "./types/families/c": {
      "types": "./dist/types/families/c.d.ts",
      "default": "./dist/types/families/c.js"
    },
    "./types/families/d": {
      "types": "./dist/types/families/d.d.ts",
      "default": "./dist/types/families/d.js"
    },
    "./types/families/e": {
      "types": "./dist/types/families/e.d.ts",
      "default": "./dist/types/families/e.js"
    },
    "./signal-classes": {
      "types": "./dist/signal-classes.d.ts",
      "default": "./dist/signal-classes.js"
    },
    "./verdict-groups": {
      "types": "./dist/verdict-groups.d.ts",
      "default": "./dist/verdict-groups.js"
    },
    "./per-detector-resampler-mode": {
      "types": "./dist/per-detector-resampler-mode.d.ts",
      "default": "./dist/per-detector-resampler-mode.js"
    },
    "./detectors/*": {
      "types": "./dist/detectors/*.d.ts",
      "default": "./dist/detectors/*.js"
    },
    "./fleet/*": {
      "types": "./dist/fleet/*.d.ts",
      "default": "./dist/fleet/*.js"
    },
    "./baseline/*": {
      "types": "./dist/baseline/*.d.ts",
      "default": "./dist/baseline/*.js"
    },
    "./per-shard/*": {
      "types": "./dist/per-shard/*.d.ts",
      "default": "./dist/per-shard/*.js"
    },
    "./guarantees": {
      "types": "./dist/guarantees.d.ts",
      "default": "./dist/guarantees.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
